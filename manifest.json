{
  "manifest_version": 3,
  "name": "Take care Sis",
  "version": "0.0.1",
  "description": "A wellness reminder for your workday.",
  "permissions": ["alarms", "notifications", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}